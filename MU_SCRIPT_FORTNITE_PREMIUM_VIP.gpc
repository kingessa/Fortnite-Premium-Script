    {-99, 99},    // AR_horizontal
    {1, 1000},    // RF_hold
    {1, 1000}     // RF_release
};

// EXIT COMBO
int exit_wait = 1500;
combo EXIT {
    wait(exit_wait);
    cls_oled(0);
    ModMenu = FALSE;
    ModEdit = FALSE;
    display_EDIT = FALSE;
    display_title = TRUE;
}

// LED BLINK COMBO
int LED_OnOff;
combo LED_BLINK {
    colourled(LED_OnOff);
    wait(200);
    colourled(ColorOFF);
    wait(100);
    colourled(LED_OnOff);
    wait(200);
    colourled(ColorOFF);
    wait(100);
}

// PROFILE VIBRATE NOTIFY
int profile_numbr;
int rumble_tipe = RUMBLE_A;
combo PROFILES_VIBRATE_NOTIFY {
    if(profile_numbr >= 1) set_rumble(rumble_tipe, 100);
    wait(300);
    reset_rumble();
    wait(100);
    if(profile_numbr > 1) set_rumble(rumble_tipe, 100);
    wait(300);
    reset_rumble();
    wait(100);
    if(profile_numbr > 2) set_rumble(rumble_tipe, 100);
    wait(300);
    reset_rumble();
}

define PRIMARY_Profile = 1;
define SECONDARY_Profile = 2;

// VIBRATE COMBO
combo vibrate {
    set_rumble(rumble_tipe, 100);
    wait(300);
    reset_rumble();
    wait(100);
    set_rumble(rumble_tipe, 100);
    wait(300);
    reset_rumble();
}

// BLINK NOTIFY COMBO
combo BLINK_NOTIFY {
    colourled(BlinckColor);
    wait(300);
    colourled(ColorOFF);
    wait(100);
    colourled(BlinckColor);
    wait(300);
    colourled(ColorOFF);
}

// MOD BLINK COMBO
int MOD_Color;
int blink_n;
combo Blink_MOD_ON {
    colourled(ColorOFF);
    wait(500);
    colourled(ColorOFF);
    wait(1000);
    blink_n += 1;
    if(blink_n > 0) blink_n = 1;
}

// STICKY AIM COMBO
combo StickyAim {
    offset_Batts_sticky(PS4_RY, AimAssistSize);
    wait(AimAssistTime);
    offset_Batts_sticky(PS4_RX, AimAssistSize);
    wait(AimAssistTime);
    offset_Batts_sticky(PS4_RY, inv(AimAssistSize));
    wait(AimAssistTime);
    offset_Batts_sticky(PS4_RX, inv(AimAssistSize));
    wait(AimAssistTime);
}

// RAPID FIRE COMBO
int KS_RapidFire = TRUE;
combo RAPID_FIRE_cmb {
    set_val(FIRE_BTN, 100);
    wait(RF_hold);
    set_val(FIRE_BTN, 0);
    wait(RF_release);
}

// ANTI RECOIL COMBO
define AR_Release = 30;
int KS_anti_recoil = TRUE;
int ANTI_RECOIL = 20;
int ANTI_RECOIL_H = 0;
int anti_recoil;
int anti_recoil_H;

combo AntiRecoil {
    anti_recoil = get_ival(RY) + AR_vertical;
    if(anti_recoil > 100) anti_recoil = 100;
    set_val(RY, anti_recoil);
    anti_recoil_H = get_ival(RX) + AR_horizontal;
    if(anti_recoil_H > 100) anti_recoil_H = 100;
    set_val(RX, anti_recoil_H);
}

// MESSAGE COMBO
const string EXIT_TXT1 = " MU SCRIPT";
const string EXIT_TXT2 = " WAS SAVED";
combo MESSAGE {
    wait(20);
    save_toggles();
    cls_oled(0);
    print(horizontal_center_offset(sizeof(EXIT_TXT1), OLED_FONT_SMALL), 10, 
          OLED_FONT_SMALL, 1, EXIT_TXT1[0]);
    print(horizontal_center_offset(sizeof(EXIT_TXT2), OLED_FONT_SMALL), 23, 
          OLED_FONT_SMALL, 1, EXIT_TXT2[0]);
    exit_wait = 2000;
}

